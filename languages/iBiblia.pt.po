#: ai_association_flow.sconfigadditionalinstructionsdescription
msgid ""
"Add specific guidelines for your project (e.g., handling of poetry, examples"
" for edge cases)"
msgstr ""
"Adicione diretrizes específicas para o seu projeto ou exemplos de "
"associações"

#: ai_association_flow.sconfigadditionalinstructionsdisplayname
msgctxt "ai_association_flow.sconfigadditionalinstructionsdisplayname"
msgid "Additional Instructions"
msgstr "Instruções adicionais"

#: ai_association_flow.sconfigapikeyoverridedescription
msgctxt "ai_association_flow.sconfigapikeyoverridedescription"
msgid ""
"Specify a different API key for this flow. Leave empty to use common "
"settings."
msgstr ""
"Especifique uma chave da API diferente para este fluxo. Deixe em branco para"
" usar as configurações comuns."

#: ai_association_flow.sconfigapikeyoverridedisplayname
msgctxt "ai_association_flow.sconfigapikeyoverridedisplayname"
msgid "API Key"
msgstr "Chave da API"

#: ai_association_flow.sconfigincludecommentsdescription
msgid ""
"If enabled, the AI will provide critical comments about the associations."
msgstr "Quando habilitado, a IA vai incluir comentários sobre a associação."

#: ai_association_flow.sconfigincludecommentsdisplayname
msgid "Include AI Comments"
msgstr "Incluir comentários da IA"

#: ai_association_flow.sconfigmodeloverridedescription
msgctxt "ai_association_flow.sconfigmodeloverridedescription"
msgid ""
"Specify a different model for this flow. Leave empty to use common settings."
msgstr ""
"Especifique um modelo diferente para este fluxo. Deixe em branco para usar "
"as configurações comuns."

#: ai_association_flow.sconfigmodeloverridedisplayname
msgctxt "ai_association_flow.sconfigmodeloverridedisplayname"
msgid "Model"
msgstr "Modelo"

#: ai_association_flow.sconfigprovideroverridedescription
msgctxt "ai_association_flow.sconfigprovideroverridedescription"
msgid ""
"Specify a different provider for this flow. Leave empty to use common "
"settings."
msgstr ""
"Especifique um provedor diferente para este fluxo. Deixe em branco para usar"
" as configurações comuns."

#: ai_association_flow.sconfigprovideroverridedisplayname
msgctxt "ai_association_flow.sconfigprovideroverridedisplayname"
msgid "Provider"
msgstr "Provedor"

#: ai_association_flow.sdescriptionassociation
msgid "Matches corresponding phrases between original and translated texts"
msgstr "Associa termos correspondentes entre os textos origem e destino"

#: ai_association_flow.sdisplaynameassociation
msgctxt "ai_association_flow.sdisplaynameassociation"
msgid "Association"
msgstr "Associação"

#: ai_association_flow.soutputformatinfoassociation
msgid ""
"This flow expects JSON output: {\"data\": [[original, translation], ...], "
"\"comments\": \"...\" (optional)}"
msgstr ""
"Este fluxo espera saída JSON: {\"data\": [[original, tradução], ...], "
"\"comments\": \"...\" (opcional)}"

#: ai_translation_flow.sconfigadditionalinstructionsdescription
msgid ""
"Add translation philosophy, terminology preferences, or context-specific "
"rules"
msgstr ""
"Adicione a filosofia de tradução, preferências de terminologia, ou regras "
"específicas"

#: ai_translation_flow.sconfigadditionalinstructionsdisplayname
msgctxt "ai_translation_flow.sconfigadditionalinstructionsdisplayname"
msgid "Additional Instructions"
msgstr "Instruções adicionais"

#: ai_translation_flow.sconfigapikeyoverridedescription
msgctxt "ai_translation_flow.sconfigapikeyoverridedescription"
msgid ""
"Specify a different API key for this flow. Leave empty to use common "
"settings."
msgstr ""
"Especifique uma chave da API diferente para este fluxo. Deixe em branco para"
" usar as configurações comuns."

#: ai_translation_flow.sconfigapikeyoverridedisplayname
msgctxt "ai_translation_flow.sconfigapikeyoverridedisplayname"
msgid "API Key"
msgstr "Chave da API"

#: ai_translation_flow.sconfigforceoverwritedescription
msgid ""
"If checked, overwrites existing translations. If unchecked, only translates "
"empty verses."
msgstr ""
"Se marcado, sobrescreve traduções existentes. Se desmarcado, só traduz "
"versículos vazios."

#: ai_translation_flow.sconfigforceoverwritedisplayname
msgid "Force Overwrite"
msgstr "Forçar sobrescrita"

#: ai_translation_flow.sconfigincludeassociationsdescription
msgid ""
"If checked, returns and applies associations between the original text and "
"the new translation."
msgstr ""

#: ai_translation_flow.sconfigincludeassociationsdisplayname
msgid "Include association of translated text"
msgstr ""

#: ai_translation_flow.sconfigmarkaddedwordsdescription
msgid ""
"If checked, asks the translator to identify words supplied without a direct "
"textual counterpart in the original."
msgstr ""

#: ai_translation_flow.sconfigmarkaddedwordsdisplayname
msgid "Mark added words"
msgstr ""

#: ai_translation_flow.sconfigmodeloverridedescription
msgctxt "ai_translation_flow.sconfigmodeloverridedescription"
msgid ""
"Specify a different model for this flow. Leave empty to use common settings."
msgstr ""
"Especifique um modelo diferente para este fluxo. Deixe em branco para usar "
"as configurações comuns."

#: ai_translation_flow.sconfigmodeloverridedisplayname
msgctxt "ai_translation_flow.sconfigmodeloverridedisplayname"
msgid "Model"
msgstr "Modelo"

#: ai_translation_flow.sconfigprovideroverridedescription
msgctxt "ai_translation_flow.sconfigprovideroverridedescription"
msgid ""
"Specify a different provider for this flow. Leave empty to use common "
"settings."
msgstr ""
"Especifique um provedor diferente para este fluxo. Deixe em branco para usar"
" as configurações comuns."

#: ai_translation_flow.sconfigprovideroverridedisplayname
msgctxt "ai_translation_flow.sconfigprovideroverridedisplayname"
msgid "Provider"
msgstr "Provedor"

#: ai_translation_flow.sconfigtargetlanguagedescription
msgid ""
"Specify the target language for translation (e.g., \"Brazilian Portuguese\","
" \"Spanish\")"
msgstr ""
"Especifique o idioma alvo da tradução (ex.: \"português brasileiro\", "
"\"espanhol\")"

#: ai_translation_flow.sconfigtargetlanguagedisplayname
msgid "Target Language"
msgstr "Idioma alvo"

#: ai_translation_flow.sdescriptiontranslation
msgid ""
"Translates biblical verses maintaining theological and stylistic accuracy"
msgstr "Traduz versículos bíblicos mantendo acurácia teológica e estilística"

#: ai_translation_flow.sdisplaynametranslation
msgctxt "ai_translation_flow.sdisplaynametranslation"
msgid "Translation"
msgstr "Tradução"

#: ai_translation_flow.soutputformatinfotranslation
#, fuzzy
#| msgid ""
#| "This flow expects plain text output without quotes or explanations"
msgid ""
"This flow expects plain text output, or a JSON object with translation and "
"data when translated-text associations are enabled."
msgstr "Este fluxo espera saída em texto simples, sem aspas ou explicações"

